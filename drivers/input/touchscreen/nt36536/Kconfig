#
# Novatek NT36536 touchscreen driver configuration
#
config TOUCHSCREEN_NT36536_SPI
	tristate "Novatek NT36536 no flash SPI driver"
	depends on SPI
	depends on DRM || DRM = n
	default n
	help
	  Say Y here if you have a Novatek NT36536 no flash touchscreen connected
	  to your system by SPI bus.
	  If unsure, say N.
