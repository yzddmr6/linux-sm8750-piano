# SPDX-License-Identifier: GPL-2.0-only
# What the installed Ubuntu desktop expects from the kernel on both SM8750
# tablets. Merge after the other sm8750 fragments and before the board
# fragment; board fragments keep only their hardware and may build an option
# in where this one makes it a module.

# Tracing, probes and BPF events: perf, bpftrace and BPF programs attach
# here, and frame-time and scheduler measurements need the tracepoints.
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y

# Ubuntu's linux-firmware ships .zst files. The loader still tries the plain
# name in every firmware path first, so local plain files keep precedence.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# systemd: PSI for systemd-oomd, zram for a swap-on-zram generator, CFS
# bandwidth for CPUQuota=, and fq_codel for the net.core.default_qdisc set
# by systemd's 50-default.conf.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_SCH_FQ_CODEL=m

# hidraw gives userspace (FIDO2 keys, controllers) access to HID devices.
# RFCOMM (HFP/HSP signalling, serial port profile) and BNEP (network
# tethering) are enabled by each board fragment, as a module or built in, as
# is uhid; their TTYs and filters are what Ubuntu's kernel offers BlueZ.
CONFIG_HIDRAW=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y

# WireGuard VPN; wg-quick and NetworkManager route a full tunnel through
# fwmark policy rules, which need multiple routing tables.
CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Desktop storage defaults: foreign binary formats, NTFS/SMB and LUKS
# volumes that GNOME Files and Disks mount through udisks (optical media
# are in sm8750-peripherals.config).
CONFIG_BINFMT_MISC=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_CIFS=m
CONFIG_DM_CRYPT=m
# Match Ubuntu desktop filename encoding when no iocharset is supplied.
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y

# The UFS controller's inline crypto engine (fscrypt keys go to the ICE
# instead of the CPU) and the UFS BSG node that ufs-utils uses.
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_SCSI_UFS_BSG=y

# Suspend works on these tablets, and these are what let anybody say so.
# pm_test asks the machine to suspend every device and resume immediately
# without entering the low-power state, which is the one suspend experiment
# that cannot end the session, and pm_debug_messages is what makes a failed
# attempt name the device that failed instead of just stopping. Both cost
# nothing while nothing asks for them.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# A suspend that hangs in a driver's callback leaves the tablet with no
# debug channel and no timer that can run: user space is frozen, and the
# Gunyah watchdog stops across system sleep by design. The device
# suspend/resume watchdog turns such a hang into a panic that names the
# device and prints the stuck task, and panic= on both boards' command
# lines turns the panic into a reboot. The warning comes first: ath12k alone
# may wait 20 s for its firmware on resume. The option is only offered under
# EXPERT; that also makes RESET_SIMPLE selectable, whose default would build
# a reset driver this SoC does not use, so it is kept off as before.
CONFIG_EXPERT=y
CONFIG_DPM_WATCHDOG=y
CONFIG_DPM_WATCHDOG_TIMEOUT=60
CONFIG_DPM_WATCHDOG_WARNING_TIMEOUT=30
# CONFIG_RESET_SIMPLE is not set
# The Gunyah watchdog's state and time left, readable without opening (and
# so arming) it.
CONFIG_WATCHDOG_SYSFS=y
