# Apply after the piano release fragments; load Gunyah after switch-root.
CONFIG_LOCALVERSION="-piano52"
CONFIG_GUNYAH=m
CONFIG_GUNYAH_HYPERCALLS=m
CONFIG_GUNYAH_TIMER=m
CONFIG_GUNYAH_PLATFORM_HOOKS=m
CONFIG_GUNYAH_IRQFD=m
CONFIG_GUNYAH_IOEVENTFD=m
# CONFIG_GUNYAH_QCOM_PLATFORM is not set
# CONFIG_GUNYAH_QCOM_TRUSTED_VM is not set
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
CONFIG_VHOST_VSOCK=m
