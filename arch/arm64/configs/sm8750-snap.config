# AppArmor mediation for strictly confined snapd applications.
# defconfig already supplies audit, seccomp, namespaces and cgroup BPF.
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,ipe,bpf"
