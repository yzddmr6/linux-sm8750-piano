# SPDX-License-Identifier: GPL-2.0-only
# Merge last for an installable piano kernel. The release is
# <kernel version>-piano<N>, so /lib/modules/<release> and the
# linux-image-<release> package are distinct for every packaged build and
# several kernels can be installed side by side. N is the package ABI number:
# take the next integer whenever the kernel commit or the resulting .config of
# a packaged kernel changes; never reuse or decrease it. Build with
# LOCALVERSION= set (empty) so Kbuild does not append "+".
CONFIG_LOCALVERSION="-piano8"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_HID_XIAOMI=m
