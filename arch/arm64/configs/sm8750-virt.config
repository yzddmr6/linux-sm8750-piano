# SPDX-License-Identifier: GPL-2.0-only
# Optional product feature fragment; the release configuration owns the ABI.
# Load Gunyah only after switch-root.
CONFIG_GUNYAH=m
CONFIG_GUNYAH_HYPERCALLS=m
CONFIG_GUNYAH_TIMER=m
CONFIG_GUNYAH_PLATFORM_HOOKS=m
CONFIG_GUNYAH_IRQFD=m
CONFIG_GUNYAH_IOEVENTFD=m
# CONFIG_GUNYAH_QCOM_PLATFORM is not set
# CONFIG_GUNYAH_QCOM_TRUSTED_VM is not set
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
CONFIG_VHOST_VSOCK=m

# Export shared memfd buffers to virtual GPU backends on both boards.
CONFIG_UDMABUF=y
CONFIG_UDMABUF_LIST_LIMIT=65536

# Utilization clamping. GunyahVM gives the threads of a virtual machine a
# utilization floor, so that schedutil runs their cores at the frequency the
# floor asks for and not at the one their low average utilization gives (a
# vCPU that sleeps and wakes thousands of times a second, the virgl decoder).
# Per-task clamps (sched_setattr, crosvm --boost-uclamp) and the cgroup
# files (cpu.uclamp.min/max), as in Ubuntu's generic arm64 kernel.
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
