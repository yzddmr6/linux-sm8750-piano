# SPDX-License-Identifier: GPL-2.0-only
# Optional product feature fragment; the release configuration owns the ABI.
# Load Gunyah only after switch-root.
CONFIG_GUNYAH=m
CONFIG_GUNYAH_HYPERCALLS=m
CONFIG_GUNYAH_TIMER=m
CONFIG_GUNYAH_PLATFORM_HOOKS=m
CONFIG_GUNYAH_IRQFD=m
CONFIG_GUNYAH_IOEVENTFD=m
# CONFIG_GUNYAH_QCOM_PLATFORM is not set
# CONFIG_GUNYAH_QCOM_TRUSTED_VM is not set
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
# CONFIG_VSOCKETS_DIAG is not set
# CONFIG_VSOCKETS_LOOPBACK is not set
CONFIG_VHOST_VSOCK=m

# Export shared memfd buffers to virtual GPU backends on both boards.
CONFIG_UDMABUF=y
CONFIG_UDMABUF_LIST_LIMIT=65536
