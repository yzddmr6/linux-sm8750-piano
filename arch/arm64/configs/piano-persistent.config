# SPDX-License-Identifier: GPL-2.0-only
# Merge after the common piano and desktop fragments. Root dependencies are
# built in; the remaining desktop drivers keep their standard module policy.
CONFIG_BOOT_CONFIG=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# The firmware scanout is the root console: simple-framebuffer holds dispcc
# clocks and GDSCs, so dispcc must bind before clk_disable_unused runs.
CONFIG_SM_DISPCC_8750=y
# Native panel/backlight providers must also be present for early takeover.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_KTZ8866=y
CONFIG_DRM_PANEL_NOVATEK_NT36532=y
# The panel and the touch transport both read the panel module ID pin, so
# gpiolib-shared serves it through proxies; the built-in panel defers until
# its proxy binds, and an initrd need not carry the proxy module.
CONFIG_GPIO_SHARED_PROXY=y
# The SM8750 PCIe Root Port reports Hot-Plug Capable. Without the native
# hotplug driver the PCI core treats it as firmware-managed and never lets it
# leave D0, so the controller keeps its link, clocks and power in suspend.
CONFIG_HOTPLUG_PCI_PCIE=y
# CONFIG_SCSI_UFS_CRYPTO is not set
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HWMON is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_LSM=y
# Ubuntu's linux-firmware ships .zst files. The loader still tries the plain
# name in every firmware path first, so local plain files keep precedence.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
# systemd on the installed Ubuntu: PSI for systemd-oomd, zram for a
# swap-on-zram generator, CFS bandwidth for CPUQuota=, and fq_codel for
# the net.core.default_qdisc set by systemd's 50-default.conf.
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_NET_SCH_FQ_CODEL=m
# BlueZ creates Bluetooth LE HID (HoG) devices through /dev/uhid; hidraw
# gives userspace (FIDO2 keys, controllers) access to HID devices.
CONFIG_UHID=m
CONFIG_HIDRAW=y
# WireGuard VPN; wg-quick and NetworkManager route a full tunnel through
# fwmark policy rules, which need multiple routing tables.
CONFIG_WIREGUARD=m
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# Yama and Landlock, both already named in CONFIG_LSM.
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
# Desktop storage defaults: foreign binary formats, NTFS/SMB/optical and
# LUKS volumes that GNOME Files and Disks mount through udisks.
CONFIG_BINFMT_MISC=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_CIFS=m
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_DM_CRYPT=m
# Match Ubuntu desktop filename encoding when no iocharset is supplied.
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_UTF8=y
# Board thermistors are runtime monitors, not root or early-console providers.
CONFIG_QCOM_SPMI_ADC5_GEN3=m
CONFIG_GENERIC_ADC_THERMAL=m

# Gunyah emulates the APSS watchdog for the HLOS VM on SM8750; qcom_scm
# registers the gunyah-wdt device. The driver keeps it stopped until a
# userspace manager (systemd RuntimeWatchdogSec) opens it, and stops it
# across system sleep.
CONFIG_GUNYAH_WATCHDOG=y
# The flash of the camera runs on the flash controller of the PMIC. The
# flash class is a menu, so the driver inside it cannot be built in while
# the menu stays a module.
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_QCOM_FLASH=y
# The wireless transmitter of the pen in its dock.
CONFIG_CHARGER_SC96231=m
