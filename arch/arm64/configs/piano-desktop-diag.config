# SPDX-License-Identifier: GPL-2.0-only
# Combined RAM desktop: same built-in input/BT/GPU as the tested variants.
# ADSP/audio and the WLAN driver retain the base's standard module policy.
# No PCIe/WLAN board enablement, storage writes or charger policy is implied.
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_HID_NANOSIC_WN8030=m
CONFIG_INPUT_EVDEV=y
CONFIG_TOUCHSCREEN_NT36532E_THP=y
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_DRM_MSM=y
CONFIG_SM_GPUCC_8750=y
CONFIG_QCOM_MDT_LOADER=y
CONFIG_QCOM_LLCC=y
# CONFIG_QCOM_OCMEM is not set
CONFIG_DRM_SIMPLEDRM=y
CONFIG_ATH12K=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QCOM_APR=m
CONFIG_SND_SOC_SC8280XP=m
CONFIG_SND_SOC_FS19XX=m
CONFIG_BATTERY_BQ27XXX=y
CONFIG_BATTERY_BQ27XXX_I2C=y
# CONFIG_BATTERY_BQ27XXX_DT_UPDATES_NVM is not set
CONFIG_CHARGER_XIAOMI_MCA=m
CONFIG_BACKLIGHT_KTZ8866=m
CONFIG_CHARGER_SC8541=m

# Community camera sensor and lens modules.
CONFIG_VIDEO_OV32D40=m
CONFIG_VIDEO_DW9768=m

# CAMSS uses the standalone CSI2 PHY driver on Linux 7.4.
CONFIG_PHY_QCOM_MIPI_CSI2=m
