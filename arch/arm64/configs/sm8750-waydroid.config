# Waydroid runs an Android userspace in an LXC container on this kernel.
#
# Binder IPC through binderfs: Waydroid mounts binderfs and allocates the
# binder, hwbinder and vndbinder nodes it hands to the container.  Binder
# cannot be built as a module.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# Android's netd installs the container's default route and DNS through IPv4
# and IPv6 policy rules.  RouteController fails without either rule set and the
# container keeps only its on-link route.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# Android's iptables only speaks the legacy x_tables interface: netd builds its
# chains in the filter, mangle, raw and nat tables of both families.  Waydroid's
# bridge script also prefers iptables-legacy for the container's DHCP and DNS
# rules, its NAT and the DHCP checksum fix.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
