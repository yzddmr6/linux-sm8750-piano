// SPDX-License-Identifier: GPL-2.0-only
/*
 * Camera nodes imported from blu-sharky/debian-piano:
 * fd6266d73f3442b23362260c3aa0c86782e0b52c, boot/dtbo-piano-camera.dts.
 * Overlay containers/labels converted to the existing upstream board tree;
 * existing clock, QUP and RPMh providers are reused, not duplicated.
 * Sensor modes and endpoint numbering are the community implementation.
 */
#include <dt-bindings/clock/qcom,sm8750-cambistmclkcc.h>
#include <dt-bindings/clock/qcom,sm8750-camcc.h>

&apps_rsc {
	regulators-0 {
		vreg_l6b_1p8: ldo6 {
			regulator-name = "vreg_l6b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l7b_2p8: ldo7 {
			regulator-name = "vreg_l7b_2p8";
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l10b_1p8: ldo10 {
			regulator-name = "vreg_l10b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&apps_rsc {
	regulators-2 {
		vreg_l2g_1p2: ldo2 {
			regulator-name = "vreg_l2g_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&apps_rsc {
	regulators-5 {
		vreg_l1i_1p1: ldo1 {
			regulator-name = "vreg_l1i_1p1";
			/* Stock L1I VSET readback is 1096 mV (2026-10-12). */
			regulator-min-microvolt = <1096000>;
			regulator-max-microvolt = <1096000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/ {
	cam_wide_avdd: regulator-camera-wide-avdd {
		compatible = "regulator-fixed";
		regulator-name = "cam_wide_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 175 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cam_wide_avdd_pins>;
		pinctrl-1 = <&cam_wide_avdd_sleep>;
	};

	cam_front_avdd: regulator-camera-front-avdd {
		compatible = "regulator-fixed";
		regulator-name = "cam_front_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 176 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cam_front_avdd_pins>;
		pinctrl-1 = <&cam_front_avdd_sleep>;
	};
};

&tlmm {
	cam_cci0_1: cam-cci0-1-state {
		sda-pins {
			pins = "gpio115";
			function = "cci_i2c_sda";
			drive-strength = <4>;
			bias-disable;
		};

		scl-pins {
			pins = "gpio116";
			function = "cci_i2c_scl";
			drive-strength = <4>;
			bias-disable;
		};
	};

	cam_wide: cam-wide-state {
		mclk-pins {
			pins = "gpio90";
			function = "cam_mclk";
			drive-strength = <4>;
			bias-disable;
		};

		reset-pins {
			pins = "gpio6";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	cam_front: cam-front-state {
		mclk-pins {
			pins = "gpio93";
			function = "cam_aon_mclk4";
			drive-strength = <2>;
			bias-disable;
		};

		reset-pins {
			pins = "gpio7";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	cam_wide_avdd_pins: cam-wide-avdd-state {
		pins = "gpio175";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cam_front_avdd_pins: cam-front-avdd-state {
		pins = "gpio176";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	cam_i2c9: cam-i2c9-state {
		pins = "gpio4", "gpio5";
		function = "qup2_se1";
		drive-strength = <2>;
		bias-disable;
	};
};

&soc {
	cci0: cci@ac7b000 {
		compatible = "qcom,sm8750-cci", "qcom,msm8996-cci";
		reg = <0x0 0xac7b000 0x0 0x1000>;
		interrupts = <GIC_SPI 426 IRQ_TYPE_EDGE_RISING>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		clocks = <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
			 <&camcc CAM_CC_CCI_0_CLK>;
		clock-names = "ahb", "cci";
		/* the only rate of the stock and mainline tables */
		assigned-clocks = <&camcc CAM_CC_CCI_0_CLK>;
		assigned-clock-rates = <37500000>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cam_cci0_1>;
		pinctrl-1 = <&cam_cci0_1>;
		#address-cells = <1>;
		#size-cells = <0>;

		cci0_i2c1: i2c-bus@1 {
			reg = <1>;
			clock-frequency = <1000000>;
			#address-cells = <1>;
			#size-cells = <0>;

			cam_wide_vcm: vcm@c {
				/* Stock uses GT9764BA; its register protocol is unverified. */
				status = "disabled";
				compatible = "giantec,gt9769";
				reg = <0x0c>;
				vin-supply = <&vreg_l6b_1p8>;
				vdd-supply = <&vreg_l7b_2p8>;
			};

			camera_wide: camera@10 {
				compatible = "samsung,s5kjn1";
				flash-leds = <&piano_camera_flash>;
				reg = <0x10>;
				power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
				clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				assigned-clock-rates = <24000000>;
				reset-gpios = <&tlmm 6 GPIO_ACTIVE_LOW>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <&cam_wide>;
				pinctrl-1 = <&cam_wide_sleep>;
				afvdd-supply = <&vreg_l7b_2p8>;
				vdda-supply = <&cam_wide_avdd>;
				vddd-supply = <&vreg_l1i_1p1>;
				vddio-supply = <&vreg_l6b_1p8>;
				orientation = <1>;
				rotation = <180>;

				port {
					cam_wide_ep: endpoint {
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <700000000>;
						remote-endpoint = <&csiphy1_ep>;
					};
				};
			};
		};
	};

	camss: isp@ad27000 {
		compatible = "qcom,sm8750-camss";
		reg = <0x0 0xad27000 0x0 0x2b00>,
		      <0x0 0xad2a000 0x0 0x2b00>,
		      <0x0 0xad2d000 0x0 0x2b00>,
		      <0x0 0xad6d000 0x0 0xa00>,
		      <0x0 0xad72000 0x0 0xa00>,
		      <0x0 0xada9000 0x0 0x2000>,
		      <0x0 0xadab000 0x0 0x2000>,
		      <0x0 0xadad000 0x0 0x2000>,
		      <0x0 0xadaf000 0x0 0x2000>,
		      <0x0 0xadb1000 0x0 0x2000>,
		      <0x0 0xadb3000 0x0 0x2000>,
		      <0x0 0xad8b000 0x0 0x400>,
		      <0x0 0xad8c000 0x0 0x400>,
		      <0x0 0xad8d000 0x0 0x400>,
		      <0x0 0xac86000 0x0 0x10000>,
		      <0x0 0xac96000 0x0 0x10000>,
		      <0x0 0xaca6000 0x0 0x10000>,
		      <0x0 0xad6e000 0x0 0x3000>,
		      <0x0 0xad73000 0x0 0x3000>;
		reg-names = "csid0",
			    "csid1",
			    "csid2",
			    "csid_lite0",
			    "csid_lite1",
			    "csiphy0",
			    "csiphy1",
			    "csiphy2",
			    "csiphy3",
			    "csiphy4",
			    "csiphy5",
			    "csitpg0",
			    "csitpg1",
			    "csitpg2",
			    "vfe0",
			    "vfe1",
			    "vfe2",
			    "vfe_lite0",
			    "vfe_lite1";

		clocks = <&camcc CAM_CC_CAMNOC_NRT_AXI_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
			 <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
			 <&camcc CAM_CC_CAM_TOP_FAST_AHB_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_0_MAIN_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_1_MAIN_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_2_MAIN_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_IFE_LITE_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_0_BAYER_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_1_BAYER_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_TFE_2_BAYER_CLK>,
			 <&camcc CAM_CC_CSID_CLK>,
			 <&camcc CAM_CC_CSID_CSIPHY_RX_CLK>,
			 <&camcc CAM_CC_CSIPHY0_CLK>,
			 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY1_CLK>,
			 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY2_CLK>,
			 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY3_CLK>,
			 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY4_CLK>,
			 <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY5_CLK>,
			 <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
			 <&gcc GCC_CAMERA_HF_AXI_CLK>,
			 <&gcc GCC_CAMERA_SF_AXI_CLK>,
			 <&camcc CAM_CC_TFE_0_MAIN_CLK>,
			 <&camcc CAM_CC_TFE_0_MAIN_FAST_AHB_CLK>,
			 <&camcc CAM_CC_TFE_1_MAIN_CLK>,
			 <&camcc CAM_CC_TFE_1_MAIN_FAST_AHB_CLK>,
			 <&camcc CAM_CC_TFE_2_MAIN_CLK>,
			 <&camcc CAM_CC_TFE_2_MAIN_FAST_AHB_CLK>,
			 <&camcc CAM_CC_TFE_0_BAYER_CLK>,
			 <&camcc CAM_CC_TFE_0_BAYER_FAST_AHB_CLK>,
			 <&camcc CAM_CC_TFE_1_BAYER_CLK>,
			 <&camcc CAM_CC_TFE_1_BAYER_FAST_AHB_CLK>,
			 <&camcc CAM_CC_TFE_2_BAYER_CLK>,
			 <&camcc CAM_CC_TFE_2_BAYER_FAST_AHB_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CLK>,
			 <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CSID_CLK>,
			 <&camcc CAM_CC_QDSS_DEBUG_XO_CLK>;
		clock-names = "camnoc_nrt_axi",
			      "camnoc_rt_axi",
			      "cpas_ahb",
			      "cpas_fast_ahb",
			      "cpas_vfe0",
			      "cpas_vfe1",
			      "cpas_vfe2",
			      "cpas_vfe_lite",
			      "cpas_vfe0_bayer",
			      "cpas_vfe1_bayer",
			      "cpas_vfe2_bayer",
			      "csid",
			      "csid_csiphy_rx",
			      "csiphy0",
			      "csiphy0_timer",
			      "csiphy1",
			      "csiphy1_timer",
			      "csiphy2",
			      "csiphy2_timer",
			      "csiphy3",
			      "csiphy3_timer",
			      "csiphy4",
			      "csiphy4_timer",
			      "csiphy5",
			      "csiphy5_timer",
			      "gcc_axi_hf",
			      "gcc_axi_sf",
			      "vfe0",
			      "vfe0_fast_ahb",
			      "vfe1",
			      "vfe1_fast_ahb",
			      "vfe2",
			      "vfe2_fast_ahb",
			      "vfe0_bayer",
			      "vfe0_bayer_fast_ahb",
			      "vfe1_bayer",
			      "vfe1_bayer_fast_ahb",
			      "vfe2_bayer",
			      "vfe2_bayer_fast_ahb",
			      "vfe_lite",
			      "vfe_lite_ahb",
			      "vfe_lite_cphy_rx",
			      "vfe_lite_csid",
			      "qdss_debug_xo";

		interrupts = <GIC_SPI 601 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 603 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 431 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 605 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 433 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 436 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 457 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 606 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 377 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csid0",
				  "csid1",
				  "csid2",
				  "csid_lite0",
				  "csid_lite1",
				  "csiphy0",
				  "csiphy1",
				  "csiphy2",
				  "csiphy3",
				  "csiphy4",
				  "csiphy5",
				  "vfe0",
				  "vfe1",
				  "vfe2",
				  "vfe_lite0",
				  "vfe_lite1";

		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
		                 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
		                <&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
		                 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
		                <&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
		                 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>,
		                <&mmss_noc MASTER_CAMNOC_NRT_ICP_SF QCOM_ICC_TAG_ALWAYS
		                 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "ahb",
		                     "hf_mnoc",
		                     "sf_mnoc",
		                     "sf_icp_mnoc";

		iommus = <&apps_smmu 0x1c00 0x0>;

		power-domains = <&camcc CAM_CC_TFE_0_GDSC>,
				<&camcc CAM_CC_TFE_1_GDSC>,
				<&camcc CAM_CC_TFE_2_GDSC>,
				<&camcc CAM_CC_TITAN_TOP_GDSC>;
		power-domain-names = "ife0",
				     "ife1",
				     "ife2",
				     "top";

		vdd-csiphy0-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy0-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy1-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy1-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy2-0p9-supply = <&vreg_l3i_0p88>;
		vdd-csiphy2-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy3-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy3-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy4-0p9-supply = <&vreg_l3i_0p88>;
		vdd-csiphy4-1p2-supply = <&vreg_l3g_1p2>;
		vdd-csiphy5-0p9-supply = <&vreg_l1f_0p88>;
		vdd-csiphy5-1p2-supply = <&vreg_l3g_1p2>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@1 {
				reg = <1>;

				csiphy1_ep: endpoint {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&cam_wide_ep>;
				};
			};

			port@4 {
				reg = <4>;

				csiphy4_ep: endpoint {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&cam_front_ep>;
				};
			};
		};
	};
};

&i2c9 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cam_i2c9>;
	pinctrl-1 = <&cam_i2c9_sleep>;
	clock-frequency = <1000000>;

	camera_front: camera@10 {
		compatible = "ovti,ov32d40";
		reg = <0x10>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clock-rates = <19200000>;
		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cam_front>;
		pinctrl-1 = <&cam_front_sleep>;
		vddio-supply = <&vreg_l10b_1p8>;
		dvdd-supply = <&vreg_l2g_1p2>;
		avdd-supply = <&cam_front_avdd>;
		orientation = <0>;
		rotation = <0>;

		port {
			cam_front_ep: endpoint {
				data-lanes = <1 2 3 4>;
				link-frequencies = /bits/ 64 <842400000>;
				remote-endpoint = <&csiphy4_ep>;
			};
		};
	};
};

&tlmm {
	cam_wide_sleep: cam-wide-sleep-state {
		mclk-pins {
			pins = "gpio90";
			function = "cam_mclk";
			drive-strength = <4>;
			bias-pull-down;
		};
		reset-pins {
			pins = "gpio6";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
			output-low;
		};
	};
	cam_front_sleep: cam-front-sleep-state {
		mclk-pins {
			pins = "gpio93";
			function = "cam_aon_mclk4";
			drive-strength = <2>;
			bias-pull-down;
		};
		reset-pins {
			pins = "gpio7";
			function = "gpio";
			drive-strength = <2>;
			bias-pull-down;
			output-low;
		};
	};
	cam_i2c9_sleep: cam-i2c9-sleep-state {
		pins = "gpio4", "gpio5";
		function = "gpio";
		drive-strength = <4>;
	};
	cam_wide_avdd_sleep: cam-wide-avdd-sleep-state {
		pins = "gpio175";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
	cam_front_avdd_sleep: cam-front-avdd-sleep-state {
		pins = "gpio176";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
		output-low;
	};
};
